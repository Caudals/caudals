{
  "name": "Caudals Editorial",
  "version": 1,
  "voice": {
    "traits": ["clear", "specific", "evidence-aware", "calm", "useful"],
    "avoid": ["AI hype", "fake urgency", "absolute compliance claims", "invented proof", "hashtag walls", "emoji bullets"]
  },
  "tokens": {
    "canvas": "#f9fafb",
    "surface": "#ffffff",
    "textPrimary": "#111827",
    "textSecondary": "#6b7280",
    "accent": "#059669",
    "accentTeal": "#0f766e",
    "ctaBackground": "#111827",
    "radiusLarge": "12px",
    "radiusExtraLarge": "16px"
  },
  "visualPrimitives": ["editorial-card", "process", "comparison", "chart", "quote-card", "cover", "carousel", "scene"],
  "constraints": {
    "gradients": false,
    "remoteFonts": false,
    "hoverRequired": false,
    "minimumBodyTextPx": 16
  }
}
