    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "jsqr": "1.4.0",
    "jszip": "3.10.2",
    "playwright": "1.63.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
