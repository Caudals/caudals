{
  "name": "@caudals/connect",
  "private": true,
  "type": "module",
  "description": "connect.caudals.com: 3D event contact cards for the Caudals founders.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "build": "vite build",
