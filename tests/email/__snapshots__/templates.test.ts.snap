exports[`email templates > schedule_skipped renders in es 2`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html lang="es" dir="ltr"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><title>Se ha omitido una ejecución programada de Caudals: no hay créditos suficientes</title></head><body style="margin:0;padding:0;background-color:#fafaf8"><div style="display:none;overflow:hidden;max-height:0;opacity:0;font-size:1px;line-height:1;color:#fafaf8">Claims assistant no se ejecutó el 2 de noviembre de 2026. No se ha cobrado nada.</div><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#fafaf8;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;color:#141413"><tbody><tr><td style="padding:32px 12px"><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;margin:0 auto;background-color:#ffffff;border-radius:14px;border:1px solid #dcdad3"><tbody><tr><td style="padding:32px 32px 28px"><p style="margin:0 0 28px;font-size:15px;font-weight:600;letter-spacing:-0.01em;color:#141413">Caudals</p><h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:600;letter-spacing:-0.02em;color:#141413">Ejecución programada omitida</h1><p style="margin:0 0 16px;font-size:16px;line-height:1.55;color:#3b3a36;font-weight:400">La ejecución programada de Claims assistant del 2 de noviembre de 2026 se ha omitido: necesita unos 340 créditos y Acme tiene 120. No se ha cobrado nada.</p><p style="margin:0 0 16px;font-size:16px;line-height:1.55;color:#3b3a36;font-weight:400">La próxima ejecución es el 7 de diciembre de 2026. Añade créditos antes para que se haga.</p><table cellPadding="0" cellSpacing="0" role="presentation" style="margin:8px 0 20px"><tbody><tr><td style="background-color:#141413;border-radius:999px"><a href="https://app.caudals.com/workspace/settings?orgId=00000000-0000-4000-8000-000000000001&amp;tab=billing&amp;view=top-up" style="display:inline-block;padding:12px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:500;border-radius:999px">Añadir créditos</a></td></tr></tbody></table><p style="margin:8px 0 0;font-size:15px;color:#141413">El equipo de Caudals</p></td></tr></tbody></table><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;margin:0 auto"><tbody><tr><td style="padding:16px 8px 0;font-size:12px;line-height:1.5;color:#6b6a63;text-align:center"><p style="margin:0 0 6px">Correo de facturación del espacio de trabajo Acme. Lo reciben sus propietarios, salvo que lo desactiven.</p><p style="margin:0 0 6px"><a href="https://app.caudals.com/workspace/settings?orgId=00000000-0000-4000-8000-000000000001&amp;tab=notifications" style="color:#6b6a63;text-decoration:underline">Cambiar ajustes de correo</a></p><p style="margin:0">Caudals · caudals.com</p></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

