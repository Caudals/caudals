exports[`email templates > welcome renders in es 1`] = `
{
  "subject": "Te damos la bienvenida a Caudals",
  "text": "Hola, Ana: te damos la bienvenida

Tu espacio de trabajo Acme está listo. Tu primer informe está a tres pasos:

1. Conecta tu asistente: el chat de tu web, una API o respuestas que importes.
2. Añade tu documentación. Caudals prepara con ella un conjunto de pruebas para que lo revises.
3. Ejecuta la prueba y lee el informe: qué falla, por qué y qué lo arregla.

Abrir tu espacio de trabajo:
https://app.caudals.com/workspace/evaluations?orgId=00000000-0000-4000-8000-000000000001

¿Dudas? Escríbenos a hello@caudals.com.

El equipo de Caudals

--
Unos pocos correos para ayudarte a empezar con Caudals. Dejan de llegar cuando tu espacio de trabajo está en marcha.
Darme de baja de estos correos: https://app.caudals.com/workspace/unsubscribe#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
Caudals · caudals.com
",
}
`;

exports[`email templates > welcome renders in es 2`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html lang="es" dir="ltr"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><title>Te damos la bienvenida a Caudals</title></head><body style="margin:0;padding:0;background-color:#fafaf8"><div style="display:none;overflow:hidden;max-height:0;opacity:0;font-size:1px;line-height:1;color:#fafaf8">Tres pasos de tu documentación a tu primer informe.</div><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="background-color:#fafaf8;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Helvetica, Arial, sans-serif;color:#141413"><tbody><tr><td style="padding:32px 12px"><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;margin:0 auto;background-color:#ffffff;border-radius:14px;border:1px solid #dcdad3"><tbody><tr><td style="padding:32px 32px 28px"><p style="margin:0 0 28px;font-size:15px;font-weight:600;letter-spacing:-0.01em;color:#141413">Caudals</p><h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:600;letter-spacing:-0.02em;color:#141413">Hola, Ana: te damos la bienvenida</h1><p style="margin:0 0 16px;font-size:16px;line-height:1.55;color:#3b3a36;font-weight:400">Tu espacio de trabajo Acme está listo. Tu primer informe está a tres pasos:</p><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="margin:0 0 20px"><tbody><tr><td style="width:28px;padding:10px 0;border-top:1px solid #dcdad3;font-size:14px;color:#6b6a63;vertical-align:top">1</td><td style="padding:10px 0;border-top:1px solid #dcdad3;font-size:15px;line-height:1.5;color:#3b3a36">Conecta tu asistente: el chat de tu web, una API o respuestas que importes.</td></tr><tr><td style="width:28px;padding:10px 0;border-top:1px solid #dcdad3;font-size:14px;color:#6b6a63;vertical-align:top">2</td><td style="padding:10px 0;border-top:1px solid #dcdad3;font-size:15px;line-height:1.5;color:#3b3a36">Añade tu documentación. Caudals prepara con ella un conjunto de pruebas para que lo revises.</td></tr><tr><td style="width:28px;padding:10px 0;border-top:1px solid #dcdad3;font-size:14px;color:#6b6a63;vertical-align:top">3</td><td style="padding:10px 0;border-top:1px solid #dcdad3;font-size:15px;line-height:1.5;color:#3b3a36">Ejecuta la prueba y lee el informe: qué falla, por qué y qué lo arregla.</td></tr></tbody></table><table cellPadding="0" cellSpacing="0" role="presentation" style="margin:8px 0 20px"><tbody><tr><td style="background-color:#141413;border-radius:999px"><a href="https://app.caudals.com/workspace/evaluations?orgId=00000000-0000-4000-8000-000000000001" style="display:inline-block;padding:12px 22px;color:#ffffff;text-decoration:none;font-size:15px;font-weight:500;border-radius:999px">Abrir tu espacio de trabajo</a></td></tr></tbody></table><p style="margin:0 0 16px;font-size:14px;line-height:1.55;color:#6b6a63;font-weight:400">¿Dudas? Escríbenos a hello@caudals.com.</p><p style="margin:8px 0 0;font-size:15px;color:#141413">El equipo de Caudals</p></td></tr></tbody></table><table width="100%" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:560px;margin:0 auto"><tbody><tr><td style="padding:16px 8px 0;font-size:12px;line-height:1.5;color:#6b6a63;text-align:center"><p style="margin:0 0 6px">Unos pocos correos para ayudarte a empezar con Caudals. Dejan de llegar cuando tu espacio de trabajo está en marcha.</p><p style="margin:0 0 6px"><a href="https://app.caudals.com/workspace/unsubscribe#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" style="color:#6b6a63;text-decoration:underline">Darme de baja de estos correos</a></p><p style="margin:0">Caudals · caudals.com</p></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;
