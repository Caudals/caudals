FROM mcr.microsoft.com/playwright:v1.63.0-noble
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY tsconfig.json ./
COPY lib ./lib
COPY services/evals-browser ./services/evals-browser
USER pwuser
CMD ["node","--conditions=react-server","--import","tsx","services/evals-browser/main.ts"]
